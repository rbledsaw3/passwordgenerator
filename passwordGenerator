#!/usr/bin/env bash

# pphgen - A robust passphrase generator.
#
# Features:
#   - Fetches true random numbers from random.org.
#   - Provides a cryptographically secure local fallback using /dev/urandom if offline.
#   - Supports custom word count, character limits, symbols, and capitalization.

# --- Script Configuration ---
# Exit immediately if a command exits with a non-zero status.
# Treat unset variables as an error when substituting.
# Pipelines return the exit status of the last command to exit with a non-zero status.
set -euo pipefail

# --- Globals and Defaults ---
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
WORD_FILE="$SCRIPT_DIR/words"
SMALL_WORD_FILE="$SCRIPT_DIR/smallwords"

USE_SHORT=false
ADD_SYMBOLS=false
ADD_CAPS=false
NUM_WORDS=""
LIMIT=""

SYMBOLS=('!' '#' '$' '^' '+' '{' '}' '[' ']' '|' ':' ',' '.')

# --- Functions ---

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Generates a secure passphrase using words from a list.

Options:
  -n, --num-words <num>  Number of words to generate. (Default: 4)
  -l, --limit <num>      Max character limit for the password.
  -s, --short            Use the shorter 'smallwords' list.
  -S, --symbols          Add random symbols between words.
  -C, --caps             Randomly capitalize letters.
  -h, --help             Show this help message.

Logic:
 - If -l is set without -n, the number of words is calculated based on the limit.
 - Passwords exceeding the limit will be truncated.

Examples:
  $(basename "$0") -n 5 -S -C
  $(basename "$0") --short --limit 24 -S
EOF
}

# Fetches truly random numbers from random.org with a local /dev/urandom fallback.
# Arguments: $1: number of integers, $2: min value, $3: max value
fetch_random_numbers() {
  local num=$1 min=$2 max=$3
  local url="https://www.random.org/integers/?num=${num}&min=${min}&max=${max}&col=1&base=10&format=plain&rnd=new"
  local numbers_output

  # Handle edge case of requesting 0 numbers
  if [[ "$num" -le 0 ]]; then
    printf ""
    return 0
  fi

  # Try fetching from random.org first
  if numbers_output=$(curl -fsS "$url" 2>/dev/null | tr -d '\r'); then

    # Use mapfile to count lines from the variable,
    # as command substitution strips trailing newlines.
    local -a numbers_array
    mapfile -t numbers_array < <(printf "%s" "$numbers_output")
    local line_count=${#numbers_array[@]}

    if [[ "$line_count" -eq "$num" ]]; then
      # Success. Print the original output string.
      # We add a newline to restore the one stripped by $(...)
      # so the downstream mapfile receives it correctly.
      printf "%s\n" "$numbers_output"
      return 0
    fi
  fi

  # Fallback to /dev/urandom if curl fails or returns unexpected data
  echo "INFO: random.org fetch failed (or count mismatch). Using local fallback /dev/urandom." >&2
  local range=$((max - min + 1))
  for ((i = 0; i < num; i++)); do
    # Read 4 bytes (32 bits) as an unsigned int, modulo by range, then shift by min
    local random_val=$(( ( $(od -An -N4 -tu4 < /dev/urandom | tr -d ' ') % range ) + min ))
    printf "%d\n" "$random_val"
  done
}

# --- Main Logic ---

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--short)       USE_SHORT=true; shift ;;
    -S|--symbols)     ADD_SYMBOLS=true; shift ;;
    -C|--caps)        ADD_CAPS=true; shift ;;
    -n|--num-words)
      [[ $# -ge 2 ]] || { echo "ERROR: -n requires a value." >&2; exit 1; }
      NUM_WORDS=$2; shift 2 ;;
    -l|--limit)
      [[ $# -ge 2 ]] || { echo "ERROR: -l requires a value." >&2; exit 1; }
      LIMIT=$2; shift 2 ;;
    -h|--help)        usage; exit 0 ;;
    *)                echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

# Set word list and parameters
AVG_LEN=9.6
ACTIVE_WORD_FILE="$WORD_FILE"
if $USE_SHORT; then
  AVG_LEN=5.5
  ACTIVE_WORD_FILE="$SMALL_WORD_FILE"
fi

# Validate that word file exists
if [[ ! -f "$ACTIVE_WORD_FILE" ]]; then
  echo "ERROR: Word file not found at: $ACTIVE_WORD_FILE" >&2
  exit 1
fi

# Calculate number of words if not specified but a limit is
if [[ -z "$NUM_WORDS" ]]; then
  if [[ -n "$LIMIT" ]]; then
    # Use integer arithmetic to calculate num_words = floor(limit / avg_len)
    NUM_WORDS=$(awk "BEGIN {print int($LIMIT / $AVG_LEN)}")
    [[ "$NUM_WORDS" -lt 1 ]] && NUM_WORDS=1 # Ensure at least one word
  else
    NUM_WORDS=4 # Default to 4 words
  fi
fi

# --- Generation ---

# 1. Get random line numbers for words
MAX_LINE=$(wc -l < "$ACTIVE_WORD_FILE" | tr -d ' ')
mapfile -t WORD_INDICES < <(fetch_random_numbers "$NUM_WORDS" 1 "$MAX_LINE")

# 2. Pick words from file
declare -a WORDS
for index in "${WORD_INDICES[@]}"; do
  WORDS+=("$(sed -n "${index}p" "$ACTIVE_WORD_FILE" | tr -d '\r')")
done

# 3. Assemble the base password
PASS=""
if $ADD_SYMBOLS && [[ ${#WORDS[@]} -gt 1 ]]; then
  NUM_SYMBOLS_NEEDED=$((${#WORDS[@]} - 1))
  mapfile -t SYM_INDICES < <(fetch_random_numbers "$NUM_SYMBOLS_NEEDED" 0 $((${#SYMBOLS[@]} - 1)))

  PASS="${WORDS[0]}"
  for (( i=0; i < NUM_SYMBOLS_NEEDED; i++ )); do
    PASS+="${SYMBOLS[${SYM_INDICES[$i]}]}${WORDS[$((i+1))]}"
  done
else
  # Join words with spaces, then replace spaces with nothing for a simple join
  # This is a bit of a trick to avoid a trailing character
  PASS=$(printf '%s ' "${WORDS[@]}")
  PASS="${PASS% }" # No separators
fi

# 4. Apply random capitalization
if $ADD_CAPS && [[ -n "$PASS" ]]; then
  PASS_LEN=${#PASS}
  mapfile -t BITS < <(fetch_random_numbers "$PASS_LEN" 0 1)

  NEW_PASS=""
  for (( i=0; i < PASS_LEN; i++ )); do
    CHAR="${PASS:i:1}"
    if [[ ${BITS[$i]} -eq 1 ]] && [[ "$CHAR" =~ [a-zA-Z] ]]; then
      NEW_PASS+="${CHAR^^}"
    else
      NEW_PASS+="$CHAR"
    fi
  done
  PASS="$NEW_PASS"
fi

# 5. Truncate to limit if necessary
if [[ -n "$LIMIT" ]] && [[ ${#PASS} -gt "$LIMIT" ]]; then
  PASS="${PASS:0:$LIMIT}"
fi

# --- Output ---
printf "%s\n" "$PASS"
